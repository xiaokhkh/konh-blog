---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Archive | konh" description="All published notes and essays.">
  <section class="container">
    <div class="section-head">
      <h1>Archive</h1>
      <span class="meta-line">{posts.length} posts</span>
    </div>
    <div class="archive-list">
      {
        posts.map((post) => (
          <a class="archive-row" href={`/posts/${post.id.replace(/\.(md|mdx)$/, '')}/`}>
            <span class="meta-line">
              {post.data.pubDate.toLocaleDateString('en', { year: 'numeric', month: 'short', day: '2-digit' })}
            </span>
            <strong>{post.data.title}</strong>
            <span class="meta-line">{post.data.tags[0] ?? 'note'}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
