---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter((post) => !post.data.draft);
const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  post.data.tags.forEach((tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
  });
  return acc;
}, {});

const tags = Object.entries(tagCounts).sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title="Tags | konh" description="Browse posts by topic.">
  <section class="container">
    <div class="section-head">
      <h1>Tags</h1>
      <span class="meta-line">{tags.length} topics</span>
    </div>
    <div class="tag-row">
      {tags.map(([tag, count]) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag} · {count}</a>)}
    </div>
  </section>
</BaseLayout>
