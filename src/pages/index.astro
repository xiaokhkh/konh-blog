---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured] = posts;
const featuredSlug = featured?.id.replace(/\.(md|mdx)$/, '');
---

<BaseLayout>
  <section class="container hero">
    <div>
      <span class="meta-line">Takahashi mode / Astro 6 / MDX</span>
      <h1>少字。大声。</h1>
      <p>
        Konh Blog is a Git-owned static site for notes that should be read fast, remembered faster, and moved anywhere.
      </p>
    </div>
    {
      featured && (
        <a class="hero-panel" href={`/posts/${featuredSlug}/`}>
          {featured.data.cover && <img src={featured.data.cover} alt={featured.data.coverAlt ?? ''} />}
          <p>{featured.data.title}</p>
        </a>
      )
    }
  </section>

  <section class="container" aria-labelledby="latest-posts">
    <div class="section-head">
      <h2 id="latest-posts">Latest</h2>
      <a href="/archive/">All posts</a>
    </div>
    <div class="post-grid">
      {posts.slice(0, 6).map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
