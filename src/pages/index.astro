---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured] = posts;
const featuredSlug = featured?.id.replace(/\.(md|mdx)$/, '');
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 12);
---

<BaseLayout>
  <section class="container hero">
    <div>
      <span class="meta-line">Essays / field notes / technical memory</span>
      <h1>Konh Index</h1>
      <p>
        A public notebook for durable arguments, implementation notes, and small discoveries that should remain
        searchable after the feed forgets them.
      </p>
      <div class="tag-row" aria-label="Topics">
        {tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
      </div>
    </div>
    {
      featured && (
        <a class="hero-panel" href={`/posts/${featuredSlug}/`}>
          {featured.data.cover && <img src={featured.data.cover} alt={featured.data.coverAlt ?? ''} />}
          <p>{featured.data.title}</p>
        </a>
      )
    }
  </section>

  <section class="container" aria-labelledby="latest-posts">
    <div class="section-head">
      <h2 id="latest-posts">Latest</h2>
      <a href="/archive/">All posts</a>
    </div>
    <div class="post-grid">
      {posts.slice(0, 6).map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
