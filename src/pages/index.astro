---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <section class="container page-character" aria-label="Konh character animation">
    <div class="sleeping-konh">
      <video src="/media/konh-idle.webm" autoplay muted loop playsinline></video>
    </div>
  </section>

  <section class="container home-posts" aria-labelledby="latest-posts">
    <div class="section-head">
      <h2 id="latest-posts">Latest essays</h2>
      <a href="/archive/">All posts</a>
    </div>
    {
      posts.length > 0 ? (
        <div class="post-grid">
          {posts.slice(0, 6).map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="empty-state">
          <p>No essays yet. New posts will appear here after they are added through the repo CMS workflow.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
