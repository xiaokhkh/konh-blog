---
import type { CollectionEntry } from 'astro:content';

type Props = {
  post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
const slug = post.id.replace(/\.(md|mdx)$/, '');
const date = post.data.pubDate.toLocaleDateString('en', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<a class="post-card" href={`/posts/${slug}/`}>
  {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" />}
  <div class="post-card-body">
    <span class="meta-line">{date}</span>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <div class="tag-row" aria-label="Tags">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>
