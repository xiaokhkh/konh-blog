<aside class="konh-overlay" data-konh-overlay aria-label="Konh mascot" tabindex="0">
  <div class="konh-overlay-character" data-konh-character>
    <div class="konh-overlay-frame" data-konh-frame aria-hidden="true"></div>
  </div>
</aside>

<script>
  const overlay = document.querySelector('[data-konh-overlay]');
  const character = document.querySelector('[data-konh-character]');
  const frame = document.querySelector('[data-konh-frame]');

  if (overlay instanceof HTMLElement && character instanceof HTMLElement && frame instanceof HTMLElement) {
    const frameCount = 36;
    const storageKey = 'konh-overlay-position';
    const clientIdKey = 'konh-overlay-client-id';
    const syncEndpoint = '/api/konh-overlay';
    const syncInterval = 700;
    const publishInterval = 120;
    const state = {
      dragging: false,
      pointerId: -1,
      dragOffsetX: 0,
      dragOffsetY: 0,
      raf: 0,
      publishTimer: 0,
      lastPublishAt: 0,
      lastSharedAt: 0,
      syncFailures: 0,
      syncEnabled: true,
      pollingTimer: 0,
      sseConnectedOnce: false,
      eventSource: null as EventSource | null,
      pendingPointer: null as null | { x: number; y: number },
    };

    const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
    const createClientId = () => {
      if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();
      return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
    };

    const getClientId = () => {
      const saved = localStorage.getItem(clientIdKey);
      if (saved) return saved;

      const clientId = createClientId();
      localStorage.setItem(clientIdKey, clientId);
      return clientId;
    };

    const clientId = getClientId();

    const getPositionRange = () => {
      const bounds = overlay.getBoundingClientRect();
      return {
        width: bounds.width,
        height: bounds.height,
        minLeft: 12,
        minTop: 12,
        maxLeft: Math.max(12, window.innerWidth - bounds.width - 12),
        maxTop: Math.max(12, window.innerHeight - bounds.height - 12),
      };
    };

    const normalizePosition = () => {
      const bounds = overlay.getBoundingClientRect();
      const range = getPositionRange();
      const availableX = Math.max(1, range.maxLeft - range.minLeft);
      const availableY = Math.max(1, range.maxTop - range.minTop);

      return {
        x: clamp((bounds.left - range.minLeft) / availableX, 0, 1),
        y: clamp((bounds.top - range.minTop) / availableY, 0, 1),
      };
    };

    const setPosition = (left: number, top: number) => {
      const range = getPositionRange();
      const nextLeft = clamp(left, range.minLeft, range.maxLeft);
      const nextTop = clamp(top, range.minTop, range.maxTop);

      overlay.style.left = `${nextLeft}px`;
      overlay.style.top = `${nextTop}px`;
      overlay.style.right = 'auto';
    };

    const setNormalizedPosition = (x: number, y: number) => {
      const range = getPositionRange();
      setPosition(
        range.minLeft + (range.maxLeft - range.minLeft) * clamp(x, 0, 1),
        range.minTop + (range.maxTop - range.minTop) * clamp(y, 0, 1),
      );
    };

    const restorePosition = () => {
      const saved = localStorage.getItem(storageKey);
      if (!saved) return;

      try {
        const position = JSON.parse(saved) as { left?: number; top?: number };
        if (typeof position.left === 'number' && typeof position.top === 'number') {
          setPosition(position.left, position.top);
        }
      } catch {
        localStorage.removeItem(storageKey);
      }
    };

    const savePosition = () => {
      const bounds = overlay.getBoundingClientRect();
      localStorage.setItem(storageKey, JSON.stringify({ left: bounds.left, top: bounds.top }));
    };

    const applySharedPosition = (position: {
      x?: number;
      y?: number;
      updatedAt?: number;
      clientId?: string;
    }) => {
      if (
        position.clientId === clientId ||
        typeof position.x !== 'number' ||
        typeof position.y !== 'number' ||
        typeof position.updatedAt !== 'number' ||
        position.updatedAt <= state.lastSharedAt
      ) {
        return;
      }

      state.lastSharedAt = position.updatedAt;
      setNormalizedPosition(position.x, position.y);
      savePosition();
    };

    const publishPosition = async () => {
      if (!state.syncEnabled) return;

      const position = normalizePosition();

      try {
        const response = await fetch(syncEndpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...position, clientId }),
          keepalive: true,
        });

        if (!response.ok) throw new Error(`Sync failed: ${response.status}`);

        const payload = (await response.json()) as {
          position?: { updatedAt?: number; clientId?: string };
        };
        state.syncFailures = 0;

        if (payload.position?.updatedAt) {
          state.lastSharedAt = Math.max(state.lastSharedAt, payload.position.updatedAt);
        }
      } catch {
        state.syncFailures += 1;
        state.syncEnabled = state.syncFailures < 3;
      }
    };

    const schedulePublish = (force = false) => {
      if (!state.syncEnabled) return;

      const now = Date.now();
      const delay = force ? 0 : Math.max(0, publishInterval - (now - state.lastPublishAt));

      window.clearTimeout(state.publishTimer);
      state.publishTimer = window.setTimeout(() => {
        state.lastPublishAt = Date.now();
        publishPosition();
      }, delay);
    };

    const pullSharedPosition = async () => {
      if (!state.syncEnabled || state.dragging || document.hidden) return;

      try {
        const response = await fetch(syncEndpoint, { cache: 'no-store' });
        if (!response.ok) throw new Error(`Sync failed: ${response.status}`);

        const payload = (await response.json()) as {
          position?: { x?: number; y?: number; updatedAt?: number; clientId?: string } | null;
        };
        state.syncFailures = 0;
        const position = payload.position;

        if (position) applySharedPosition(position);
      } catch {
        state.syncFailures += 1;
        state.syncEnabled = state.syncFailures < 3;
      }
    };

    const startPollingFallback = () => {
      if (state.pollingTimer) return;
      state.pollingTimer = window.setInterval(pullSharedPosition, syncInterval);
      pullSharedPosition();
    };

    const startSseSync = () => {
      if (!('EventSource' in window)) {
        startPollingFallback();
        return;
      }

      const eventSource = new EventSource(syncEndpoint);
      state.eventSource = eventSource;

      eventSource.addEventListener('open', () => {
        state.sseConnectedOnce = true;
        state.syncFailures = 0;
      });

      eventSource.addEventListener('position', (event) => {
        if (state.dragging) return;

        try {
          applySharedPosition(JSON.parse((event as MessageEvent).data));
          state.syncFailures = 0;
        } catch {
          state.syncFailures += 1;
        }
      });

      eventSource.addEventListener('error', () => {
        if (state.sseConnectedOnce) return;

        state.syncFailures += 1;
        if (state.syncFailures < 3) return;

        eventSource.close();
        if (state.eventSource === eventSource) state.eventSource = null;
        startPollingFallback();
      });
    };

    const updateGaze = (x: number, y: number) => {
      const bounds = overlay.getBoundingClientRect();
      const centerX = bounds.left + bounds.width / 2;
      const centerY = bounds.top + bounds.height / 2;
      const angle = Math.atan2(y - centerY, x - centerX);
      const normalizedAngle = (angle + Math.PI * 2) % (Math.PI * 2);
      const frameIndex = Math.round((normalizedAngle / (Math.PI * 2)) * frameCount) % frameCount;
      const normalizedX = clamp(x / window.innerWidth, 0, 1) - 0.5;
      const normalizedY = clamp(y / window.innerHeight, 0, 1) - 0.5;

      frame.style.setProperty('--konh-col', String(frameIndex % 6));
      frame.style.setProperty('--konh-row', String(Math.floor(frameIndex / 6)));
      character.style.setProperty('--konh-follow-x', `${(normalizedX * 24).toFixed(2)}px`);
      character.style.setProperty('--konh-follow-y', `${(normalizedY * 16).toFixed(2)}px`);
      character.style.setProperty('--konh-tilt', `${(normalizedX * 7).toFixed(2)}deg`);
    };

    const scheduleGaze = (x: number, y: number) => {
      state.pendingPointer = { x, y };
      if (state.raf) return;

      state.raf = requestAnimationFrame(() => {
        state.raf = 0;
        if (state.pendingPointer) {
          updateGaze(state.pendingPointer.x, state.pendingPointer.y);
        }
      });
    };

    restorePosition();

    window.addEventListener('pointermove', (event) => {
      scheduleGaze(event.clientX, event.clientY);

      if (!state.dragging || event.pointerId !== state.pointerId) return;
      setPosition(event.clientX - state.dragOffsetX, event.clientY - state.dragOffsetY);
      schedulePublish();
    });

    overlay.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;

      const bounds = overlay.getBoundingClientRect();
      state.dragging = true;
      state.pointerId = event.pointerId;
      state.dragOffsetX = event.clientX - bounds.left;
      state.dragOffsetY = event.clientY - bounds.top;
      overlay.classList.add('is-dragging');
      overlay.setPointerCapture(event.pointerId);
    });

    overlay.addEventListener('pointerup', (event) => {
      if (!state.dragging || event.pointerId !== state.pointerId) return;

      state.dragging = false;
      state.pointerId = -1;
      overlay.classList.remove('is-dragging');
      overlay.releasePointerCapture(event.pointerId);
      savePosition();
      schedulePublish(true);
    });

    window.addEventListener('resize', () => {
      const bounds = overlay.getBoundingClientRect();
      setPosition(bounds.left, bounds.top);
    });

    startSseSync();
  }
</script>
